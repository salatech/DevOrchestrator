# Environment variables for the DevOrchestrator CLI (local runtime).
# Copy to `.env` locally if you want; never commit real values.
# This file is placeholders only. The CLI reads the process environment
# (export these in your shell, or use Node 20+ `--env-file`).

# --- Required for planning / review (pick the providers you configured) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Optional process-level runtime (not project `.ai/` config) ---
# development | test | production
# DEVAI_ENV=development

# silent | error | warn | info | debug
# DEVAI_LOG_LEVEL=info

# Validation command timeout in milliseconds
# DEVAI_COMMAND_TIMEOUT_MS=120000

# Optional config overlays (see README)
# DEVAI_PLANNER_PROVIDER=openai
# DEVAI_PLANNER_MODEL=gpt-4o
# DEVAI_EXECUTOR_AGENT=codex
# DEVAI_REVIEWER_PROVIDER=openai
# DEVAI_REVIEWER_MODEL=gpt-4o
# DEVAI_MAX_ITERATIONS=3

# Telemetry is off unless set to 1. This version still sends no product analytics.
# DEVAI_TELEMETRY=0

# Reserved for a future optional cloud control plane. Unused by the local runtime.
# DEVAI_CLOUD_ENDPOINT=
